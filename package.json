{
  "name": "ts-move-helper",
  "displayName": "TS Move Helper",
  "publisher": "kinyusui",
  "description": "Move many TS files",
  "main": "./dist/Extension/RegisterExtension.js",
  "version": "0.0.19",
  "icon": "./TS_Icon.png",
  "repository": "https://github.com/kinyusui/MoveLogic",
  "categories": [
    "Formatters",
    "Other"
  ],
  "license": "UNLICENSED",
  "keywords": [
    "Typescript",
    "TS",
    "ts",
    "move",
    "multi",
    "tsMove",
    "tsmove",
    "tsMultiMove"
  ],
  "runtimeArgs": [
    "--nocrankshaft",
    "--no-turbo-inlining"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "tsMoveHelper.move",
        "title": "Move TypeScript File/Dir"
      },
      {
        "command": "tsMoveHelper.acceptQuickPickSuggestion",
        "title": "Accept Quick Pick Suggestion"
      }
    ],
    "keybindings": [
      {
        "key": "tab",
        "command": "tsMoveHelper.acceptQuickPickSuggestion",
        "when": "inQuickOpen"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "tsMoveHelper.move",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "publish": "vsce publish --no-dependencies",
    "vscode:prepublish": "npm run clean_compile",
    "compile": "esbuild ./src/Extension/RegisterExtension.ts --bundle --outfile=dist/Extension/RegisterExtension.js --external:vscode --format=cjs --platform=node",
    "clean_compile": "rimraf ./dist && npm run compile",
    "compile_watch": "npm run compile -- --watch",
    "testCompile": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vitest",
    "type_check": "npx tsc --noEmit --watch"
  },
  "dependencies": {
    "callsites": "^4.2.0",
    "cli-progress": "^3.12.0",
    "fs-extra": "^11.2.0",
    "jscodeshift": "^17.3.0",
    "rimraf": "^6.0.1",
    "ts-morph": "^22.0.0",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/fs-extra": "^11.0.4",
    "@types/jscodeshift": "^17.3.0",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "esbuild": "^0.27.7",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-testing-library": "^7.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
