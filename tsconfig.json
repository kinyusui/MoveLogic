{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "outDir": "out",
    "rootDir": "src",
    "strict": true,
    "sourceMap": true,
    "inlineSources": true,
    "allowJs": true,
    "jsx": "react-jsx",
    "skipLibCheck": true // Skip type checking of declaration files
  },
  "include": ["./src"],
  "exclude": ["node_modules", "**/node_modules/*"]
}
